<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Momentum.SharedKernel</RootNamespace>
    <AssemblyName>Momentum.SharedKernel</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Plain class library (Microsoft.NET.Sdk), but modules need ASP.NET Core
      abstractions (IServiceCollection, IEndpointRouteBuilder, IConfiguration, ...).
      FrameworkReference works on non-Sdk.Web projects too and avoids pulling in
      the full ASP.NET Core NuGet surface as ordinary package references.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

</Project>
