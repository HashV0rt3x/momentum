{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "momentum-api",
    "Audience": "momentum-client",
    "AccessMinutes": 15,
    "RefreshDays": 30
  },
  "Cors": {
    "Origins": ""
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Modules": {
    "Enabled": ""
  },
  "AllowedHosts": "*"
}
