# Copy to .env and fill in real values. Never commit the real .env file.
# NuGet restore uses public nuget.org directly (see NuGet.Config) — no env var needed.

# --- Database ---
POSTGRES_DB=momentum
POSTGRES_USER=momentum
POSTGRES_PASSWORD=change-me
ConnectionStrings__Default=Host=postgres;Port=5432;Database=momentum;Username=momentum;Password=change-me

# --- JWT ---
# Secret must be a long, random string (>= 32 bytes) — used to sign access tokens.
Jwt__Secret=change-me-to-a-long-random-secret-at-least-32-bytes
Jwt__Issuer=momentum-api
Jwt__Audience=momentum-client
Jwt__AccessMinutes=15
Jwt__RefreshDays=30

# --- CORS ---
Cors__Origins=http://localhost:5173

# --- Telegram (auth + notifications) ---
# Bot token from @BotFather — required for POST /auth/telegram.
Telegram__BotToken=
Telegram__BotUsername=

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
