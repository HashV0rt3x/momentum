# Copy to .env and fill in real values. Never commit the real .env file.

# --- NuGet restore (build-time only; see NuGet.Config) ---
NUGET_SOURCE_URL=https://nexus.yourcompany.internal/repository/nuget-group/index.json
NUGET_SOURCE_USERNAME=
NUGET_SOURCE_PASSWORD=

# --- Database ---
POSTGRES_DB=momentum
POSTGRES_USER=momentum
POSTGRES_PASSWORD=change-me
ConnectionStrings__Default=Host=postgres;Port=5432;Database=momentum;Username=momentum;Password=change-me

# --- JWT ---
# Secret must be a long, random string (>= 32 bytes) — used to sign access tokens.
Jwt__Secret=change-me-to-a-long-random-secret-at-least-32-bytes
Jwt__Issuer=momentum-api
Jwt__Audience=momentum-client
Jwt__AccessMinutes=15
Jwt__RefreshDays=30

# --- CORS ---
Cors__Origins=http://localhost:5173

# --- Notifications ---
Telegram__BotToken=

# --- Modules ---
# Comma-separated list of module names to enable. Leave blank/unset to enable all
# discovered modules.
Modules__Enabled=

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
