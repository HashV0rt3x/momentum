<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Air-gapped / Nexus mirror configuration.
    Do NOT hardcode nuget.org here. The single package source is read from the
    NUGET_SOURCE_URL environment variable (NuGet expands %VAR% in config values
    on every OS). Set it before `dotnet restore`:

      export NUGET_SOURCE_URL="https://nexus.yourcompany.internal/repository/nuget-group/index.json"

    For local dev with no Nexus available yet, set it to https://api.nuget.org/v3/index.json.
    docker build must receive the same value via --build-arg NUGET_SOURCE_URL=... (see Dockerfile).
  -->
  <packageSources>
    <clear />
    <add key="Mirror" value="%NUGET_SOURCE_URL%" />
  </packageSources>

  <!--
    If your Nexus feed requires auth, don't add credentials here (an unset env var
    would expand to a literal "%VAR%" string and break anonymous restores). Instead run
    once, locally / in CI, and it will be stored in your user-level NuGet.Config, not this file:

      dotnet nuget update source Mirror --source "$NUGET_SOURCE_URL" \
        --username "$NUGET_SOURCE_USERNAME" --password "$NUGET_SOURCE_PASSWORD" \
        --store-password-in-clear-text --configfile NuGet.Config
  -->

  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>

</configuration>
