<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Using public nuget.org directly for now (simpler local dev, no env var needed).

    If/when this needs to run air-gapped against an internal Nexus mirror, swap the
    value below for your feed URL, or reintroduce the %NUGET_SOURCE_URL% env-var
    parameterization (NuGet expands %VAR% in config values on every OS) — see git
    history prior to this commit for that version of this file.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>

</configuration>
